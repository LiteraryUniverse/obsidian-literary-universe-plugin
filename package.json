{
	"name": "literary-universe-plugin",
	"version": "0.1.0",
	"description": "Obsidian plugin for Literary Universe integration",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --test src/*.test.ts"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.2",
		"@types/node": "^18.11.18",
		"esbuild": "0.25.12",
		"eslint-plugin-obsidianmd": "0.5.1",
		"globals": "16.5.0",
		"jiti": "2.6.1",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.51.0"
	},
	"dependencies": {
		"@literary-universe/sdk": "0.3.3",
		"obsidian": "1.14.4"
	}
}
